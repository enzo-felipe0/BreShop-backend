generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserType {
  COMPRADOR
  VENDEDOR
}

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model User {
  id          String    @id @default(uuid())
  nome        String
  email       String    @unique
  senha       String
  tipoUsuario UserType
  products    Product[]
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

model Product {
  id          String         @id @default(uuid())
  nome        String
  descricao   String
  preco       Float
  quantidade  Int
  vendedorId  String
  vendedor    User           @relation(fields: [vendedorId], references: [id])
  fotos       ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderItems  OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Order {
  id         String      @id @default(uuid())
  compradorId String
  comprador   User        @relation(fields: [compradorId], references: [id])
  items      OrderItem[]
  status     OrderStatus @default(PENDENTE)
  total      Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantidade Int
  preco      Float

  @@map("order_items")
}
